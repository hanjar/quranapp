{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/sfx/*.wav",
          "/fonts/*.woff2"
        ]
      }
    },
    {
      "name": "content-metadata",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/content/*/*.json",
          "!/content/*/latin.json",
          "!/content/*/arabic.json",
          "!/content/*/translation-id.json"
        ]
      }
    },
    {
      "name": "content-ayah-texts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/content/*/latin.json",
          "/content/*/arabic.json",
          "/content/*/translation-id.json"
        ]
      }
    },
    {
      "name": "content-tafsir",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/content/*/tafsir/*.json"
        ]
      }
    },
    {
      "name": "content-qcf",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/content/*/qcf/*.json"
        ]
      }
    },
    {
      "name": "icons",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "qcf-fonts",
      "urls": [
        "https://verses.quran.foundation/fonts/quran/hafs/v4/colrv1/woff2/*.woff2"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 700,
        "maxAge": "365d"
      }
    },
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 30,
        "maxAge": "365d"
      }
    }
  ]
}
